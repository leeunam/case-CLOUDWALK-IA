# Configuração local. O Compose também usa esses valores como padrão.
COMPOSE_PROJECT_NAME=cloudwalk
API_PORT=3000
WEB_PORT=5173
POSTGRES_USER=cloudwalk
POSTGRES_PASSWORD=cloudwalk_local
# Retenção de eventos configurada em 7 dias, independente do consumo.
# O valor -1 desativa a expiração por tempo.
KAFKA_RETENTION_MS=604800000
# disabled, fixture (dados sintéticos) ou http (requer TYPESAFE_API_KEY).
CLOUDWALK_JEV_MODE=disabled
CLOUDWALK_JEV_MODEL=jev-latest
# Códigos de marcas com canais expostos ao cliente sintético.
CLOUDWALK_SIMULATOR_BRANDS=aurora,horizonte
