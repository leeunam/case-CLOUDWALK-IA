{
	admin off
	auto_https disable_redirects
	default_sni 127.0.0.1
	skip_install_trust
}

(application) {
	@rails path /api /api/* /webhooks /webhooks/* /cable /cable/*
	handle @rails {
		reverse_proxy api:3000 {
			header_up -Forwarded
			header_up -X-Forwarded-Port
		}
	}

	handle /.* {
		respond 404
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx
		}
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

http://:8080 {
	@public host {$PUBLISH_PUBLIC_HOST:disabled.invalid}
	handle @public {
		import application
	}

	@local_health {
		host 127.0.0.1 localhost
		path /api/v1/health
	}
	handle @local_health {
		reverse_proxy api:3000
	}
	handle {
		respond "Origem indisponível" 421
	}
}

https://127.0.0.1:8443 {
	tls internal
	import application
}
