{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "subject": {
      "type": "object",
      "required": [
        "id",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "category": {
          "enum": [
            "pix",
            "payouts",
            "terminal"
          ]
        }
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": [
        "id",
        "subject_id",
        "synonyms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "synonyms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "ontology": {
      "type": "object",
      "required": [
        "schema_version",
        "version",
        "subjects",
        "intents",
        "conditions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/subject"
          }
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/intent"
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "fictional"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "fictional": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "required": [
        "id",
        "intent_id",
        "requires",
        "source_id",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "intent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "requires": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "handoff_rule": {
      "type": "object",
      "required": [
        "id",
        "reason",
        "source_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "reason": {
          "enum": [
            "human_requested",
            "no_guidance",
            "sensitive_operation"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": [
        "schema_version",
        "ontology_version",
        "version",
        "brand_id",
        "slug",
        "sources",
        "procedures",
        "handoff_rules"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "ontology_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "brand_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "slug": {
          "enum": [
            "aurora",
            "horizonte"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "procedures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/procedure"
          }
        },
        "handoff_rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/handoff_rule"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ontology"
    },
    {
      "$ref": "#/$defs/brand"
    }
  ]
}
