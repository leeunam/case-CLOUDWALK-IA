{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contratos Help Desk CloudWalk v1",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Priority": {
      "type": "string",
      "enum": [
        "basic",
        "intermediate",
        "advanced",
        "urgent"
      ]
    },
    "CategoryKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "examples": [
        "pix",
        "payouts",
        "terminal"
      ],
      "description": "Identificador do catálogo ativo. Os exemplos são categorias do seed."
    },
    "CaseStatus": {
      "type": "string",
      "enum": [
        "classification_pending",
        "classification_review",
        "ai_active",
        "waiting_human",
        "human_active",
        "waiting_customer",
        "waiting_resumption",
        "resolved"
      ]
    },
    "IntegrationStatus": {
      "type": "string",
      "enum": [
        "idle",
        "pending_delivery",
        "awaiting_result",
        "failed"
      ]
    },
    "ActorType": {
      "type": "string",
      "enum": [
        "system",
        "customer",
        "ai",
        "human",
        "supervisor"
      ]
    },
    "Actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Identidade interna quando aplicável."
    },
    "Assignee": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/Uuid",
              "description": "UUID de Attendant, seja humano ou IA."
            },
            "type": {
              "type": "string",
              "enum": [
                "ai",
                "human"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ClassificationSource": {
      "type": "string",
      "enum": [
        "channel",
        "jev",
        "supervisor"
      ]
    },
    "Classification": {
      "type": "object",
      "required": [
        "category",
        "category_source",
        "priority",
        "priority_source"
      ],
      "properties": {
        "category": {
          "oneOf": [
            {
              "$ref": "#/$defs/CategoryKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "category_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/ClassificationSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "oneOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/ClassificationSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Cada origem é nula quando seu campo está ausente. Campo preenchido tem origem.",
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "category_source": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "category_source": {
                "$ref": "#/$defs/ClassificationSource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "priority": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "priority_source": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "priority_source": {
                "$ref": "#/$defs/ClassificationSource"
              }
            }
          }
        }
      ]
    },
    "ValidatedClassification": {
      "allOf": [
        {
          "$ref": "#/$defs/Classification"
        },
        {
          "properties": {
            "category": {
              "$ref": "#/$defs/CategoryKey"
            },
            "priority": {
              "$ref": "#/$defs/Priority"
            }
          }
        }
      ]
    },
    "ChannelMessage": {
      "type": "object",
      "required": [
        "source_event_id",
        "external_conversation_id",
        "external_customer_id",
        "text"
      ],
      "properties": {
        "source_event_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "external_conversation_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "external_customer_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "text": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "category": {
          "description": "Ausência, null e string vazia acionam complemento. Qualquer outro valor é avaliado na triagem."
        },
        "priority": {
          "description": "Ausência, null e string vazia acionam complemento. Qualquer outro valor é avaliado na triagem."
        }
      },
      "additionalProperties": false
    },
    "ChannelReceipt": {
      "type": "object",
      "required": [
        "case_id",
        "correlation_id"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/Uuid"
        },
        "correlation_id": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "additionalProperties": false
    },
    "AgentReceipt": {
      "type": "object",
      "required": [
        "event_id",
        "disposition"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "applied",
            "duplicate",
            "discarded"
          ]
        }
      },
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "required": [
        "id",
        "sequence",
        "author",
        "text",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "author": {
          "$ref": "#/$defs/Actor"
        },
        "text": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "AgentRequestPayload": {
      "type": "object",
      "required": [
        "classification",
        "history"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/ValidatedClassification"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "description": "Histórico em sequence crescente. A aplicação verifica a ordem e IDs únicos."
    },
    "AgentHandoffPayload": {
      "type": "object",
      "required": [
        "request_event_id",
        "summary",
        "message_ids"
      ],
      "properties": {
        "request_event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "summary": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "message_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "text": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "AgentEnvelope": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "occurred_at",
        "correlation_id",
        "case_id",
        "brand_id",
        "assignment_generation",
        "turn_id",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "event_type": {
          "type": "string"
        },
        "occurred_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "correlation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "case_id": {
          "$ref": "#/$defs/Uuid"
        },
        "brand_id": {
          "$ref": "#/$defs/Uuid"
        },
        "assignment_generation": {
          "type": "integer",
          "minimum": 1
        },
        "turn_id": {
          "$ref": "#/$defs/Uuid"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "AgentTurnRequested": {
      "allOf": [
        {
          "$ref": "#/$defs/AgentEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "agent.turn.requested"
            },
            "payload": {
              "$ref": "#/$defs/AgentRequestPayload"
            }
          }
        }
      ]
    },
    "AgentReplyProposed": {
      "allOf": [
        {
          "$ref": "#/$defs/AgentEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "agent.reply.proposed"
            },
            "payload": {
              "$ref": "#/$defs/AgentMessagePayload"
            }
          }
        }
      ]
    },
    "AgentResolveProposed": {
      "allOf": [
        {
          "$ref": "#/$defs/AgentEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "agent.resolve.proposed"
            },
            "payload": {
              "$ref": "#/$defs/AgentMessagePayload"
            }
          }
        }
      ]
    },
    "AgentHandoffProposed": {
      "allOf": [
        {
          "$ref": "#/$defs/AgentEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "agent.handoff.proposed"
            },
            "payload": {
              "$ref": "#/$defs/AgentHandoffPayload"
            }
          }
        }
      ]
    },
    "AgentResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/AgentReplyProposed"
        },
        {
          "$ref": "#/$defs/AgentResolveProposed"
        },
        {
          "$ref": "#/$defs/AgentHandoffProposed"
        }
      ]
    },
    "Error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "message": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "details": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "HealthSuccess": {
      "type": "object",
      "required": [
        "status",
        "database"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "database": {
          "const": "ok"
        }
      },
      "additionalProperties": false
    },
    "HealthUnavailable": {
      "type": "object",
      "required": [
        "status",
        "database"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "database": {
          "const": "unavailable"
        }
      },
      "additionalProperties": false
    },
    "SessionLogin": {
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "required": [
        "user",
        "csrf_token",
        "operation"
      ],
      "properties": {
        "user": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "id",
                "name",
                "role",
                "brand_ids",
                "attendant_id"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/Uuid",
                  "description": "UUID de User para analista e supervisor. Para o simulador, UUID da identidade sintética da sessão."
                },
                "name": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "analyst",
                    "supervisor",
                    "simulator"
                  ]
                },
                "brand_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Uuid"
                  },
                  "uniqueItems": true
                },
                "attendant_id": {
                  "description": "UUID de Attendant que aparece em Case.assignee.id para um analista.",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "if": {
                "properties": {
                  "role": {
                    "const": "analyst"
                  }
                }
              },
              "then": {
                "properties": {
                  "attendant_id": {
                    "$ref": "#/$defs/Uuid"
                  }
                }
              },
              "else": {
                "properties": {
                  "attendant_id": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "csrf_token": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "active_brand_id",
                "switch_target_brand_id",
                "available",
                "active_count",
                "portfolio_count",
                "portfolio_limit",
                "profile_version"
              ],
              "properties": {
                "active_brand_id": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "switch_target_brand_id": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "available": {
                  "type": "boolean"
                },
                "active_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "portfolio_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "portfolio_limit": {
                  "type": "integer",
                  "minimum": 1
                },
                "profile_version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "OperationUpdate": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "switch_target_brand_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "Case": {
      "type": "object",
      "required": [
        "id",
        "brand_id",
        "queue_id",
        "channel_id",
        "status",
        "assignee",
        "classification",
        "integration_status",
        "version",
        "created_at",
        "updated_at",
        "previous_case_id",
        "human_queue_since",
        "blocking_reason",
        "handoff"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "brand_id": {
          "$ref": "#/$defs/Uuid"
        },
        "queue_id": {
          "$ref": "#/$defs/Uuid"
        },
        "channel_id": {
          "$ref": "#/$defs/Uuid"
        },
        "status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "assignee": {
          "$ref": "#/$defs/Assignee"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "integration_status": {
          "$ref": "#/$defs/IntegrationStatus"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "previous_case_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "human_queue_since": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "summary",
                "message_ids"
              ],
              "properties": {
                "summary": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "message_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Uuid"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CaseList": {
      "type": "object",
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Case"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MessageList": {
      "type": "object",
      "required": [
        "items",
        "next_after_sequence"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "next_after_sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "NewCaseMessage": {
      "type": "object",
      "required": [
        "text",
        "expected_version"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "CaseMessageResult": {
      "type": "object",
      "required": [
        "case",
        "message"
      ],
      "properties": {
        "case": {
          "$ref": "#/$defs/Case"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    },
    "CaseActionBase": {
      "type": "object",
      "required": [
        "type",
        "expected_version"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "CaseAction": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/CaseActionBase"
        },
        {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "text"
              ],
              "properties": {
                "type": {
                  "const": "wait_for_customer"
                },
                "text": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "resolve"
                },
                "reason": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "reason",
                "destination_queue_id"
              ],
              "properties": {
                "type": {
                  "const": "transfer"
                },
                "reason": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "destination_queue_id": {
                  "$ref": "#/$defs/Uuid"
                },
                "destination_assignee_id": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "reason"
              ],
              "properties": {
                "type": {
                  "const": "retry_agent"
                },
                "reason": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "reason",
                "summary"
              ],
              "properties": {
                "type": {
                  "const": "force_handoff"
                },
                "reason": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "summary": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              }
            }
          ]
        }
      ]
    },
    "CaseClassificationCorrection": {
      "type": "object",
      "required": [
        "expected_version",
        "reason",
        "category",
        "priority"
      ],
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/CategoryKey"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        }
      },
      "additionalProperties": false
    },
    "AuditEvent": {
      "type": "object",
      "required": [
        "id",
        "case_id",
        "correlation_id",
        "occurred_at",
        "actor",
        "type",
        "reason",
        "previous_status",
        "new_status"
