{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "reply": {
      "type": "object",
      "required": [
        "action",
        "kind",
        "procedure_id",
        "text",
        "source_refs",
        "message_ids"
      ],
      "properties": {
        "action": {
          "const": "reply"
        },
        "kind": {
          "enum": [
            "procedure",
            "clarify"
          ]
        },
        "procedure_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          }
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": [
        "action",
        "rule_id",
        "text",
        "source_refs",
        "message_ids"
      ],
      "properties": {
        "action": {
          "const": "handoff"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          }
        }
      },
      "additionalProperties": false
    },
    "resolve": {
      "type": "object",
      "required": [
        "action",
        "text",
        "source_refs",
        "message_ids"
      ],
      "properties": {
        "action": {
          "const": "resolve"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "source_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/reply"
    },
    {
      "$ref": "#/$defs/handoff"
    },
    {
      "$ref": "#/$defs/resolve"
    }
  ]
}
